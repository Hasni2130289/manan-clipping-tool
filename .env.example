# Manan Clipping Tool — copy to .env and adjust. All values have sane defaults.
# JOB_DIR: where downloaded sources, transcripts and rendered clips are stored.
#   Relative paths are resolved against the project root.
JOB_DIR=./jobs
# MAX_DURATION: longest source video accepted, in seconds (default 14400 = 4 hours).
MAX_DURATION=14400
# MAX_FILE_MB: largest downloaded source file accepted, in megabytes (default 2048).
MAX_FILE_MB=2048
# WHISPER_MODEL: faster-whisper / openai-whisper model name.
#   Keep "tiny" on small machines (4 CPU / ~8 GB RAM). Larger models need more RAM.
WHISPER_MODEL=tiny
# HOST: interface the server binds to.
HOST=0.0.0.0
# PORT: port the server listens on.
PORT=8000
# APP_PASSWORD_HASH: SHA-256 hex digest of the login password.
#   Only the hash goes here — never a plain password. Generate it with:
#     printf '%s' 'new-password' | sha256sum
#   then paste the resulting hex digest as the value and restart the server.
#   If unset, the built-in default hash is used.
# APP_PASSWORD_HASH=
# CORS_ORIGINS: comma-separated origins allowed to call the API
#   cross-origin (e.g. the Muse Space frontend URL). Default "*" allows all.
# CORS_ORIGINS=*
# JOB_RETENTION_DAYS: finished jobs (ready/done/error) older than this many
#   days are deleted from disk and the job list (default 7).
# JOB_RETENTION_DAYS=7
